<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpenseTracker"
        android:name=".ExpenseTrackerApp">

        <activity android:name=".ui.auth.RegisterActivity" />

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity android:name=".ui.home.HomeActivity" />

        <activity android:name=".ui.home.AddExpenseActivity" />

        <activity android:name=".ui.home.ExpenseListActivity" />

        <activity android:name=".ui.home.EditExpenseActivity" />

        <activity android:name=".ui.home.ChartActivity" />

        <activity android:name=".ui.home.MonthlySummaryActivity" />

        <activity android:name=".ui.home.BudgetActivity" />

        <activity android:name=".ui.home.CategoryChartActivity" />

        <activity android:name=".ui.home.PdfReportActivity" />

        <activity android:name=".ui.settings.SettingsActivity" />

        <receiver
            android:name=".utils.ReminderReceiver"
            android:exported="false" />

    </application>

</manifest>